import os
import sys
import time
import requests
import json
import base64
import subprocess
from pathlib import Path

class TPMHandler:
    """Manipula operações TPM para produção com correções"""
    
    def __init__(self):
        self.ready, self.reason = self._check_tpm_availability()
        if not self.ready:
            print(f"❌ TPM não disponível: {self.reason}")
            sys.exit(1)
        print("✅ TPM inicializado para produção")
    
    def _check_tpm_availability(self):
        """Verifica se o TPM está disponível com múltiplas abordagens"""
        try:
            # Verificar se dispositivo TPM existe
            tpm_devices = ['/dev/tpm0', '/dev/tpmrm0']
            available_devices = [d for d in tpm_devices if os.path.exists(d)]
            
            if not available_devices:
                return False, "Nenhum dispositivo TPM encontrado"
            
            print(f"✅ Dispositivos TPM encontrados: {available_devices}")
            
            # Tentar diferentes métodos de acesso ao TPM
            tcti_options = [
                "device:/dev/tpm0",
                "device:/dev/tpmrm0",
                "abrmd:bus_type=session"  # Usando o resource manager
            ]
            
            for tcti in tcti_options:
                try:
                    print(f"🔧 Testando TCTI: {tcti}")
                    result = subprocess.run(
                        ['tpm2_getrandom', '4', '--tcti', tcti], 
                        capture_output=True, 
                        timeout=10
                    )
                    
                    if result.returncode == 0:
                        print(f"✅ TPM responde com TCTI: {tcti}")
                        self.tcti = tcti
                        return True, f"TPM operacional com {tcti}"
                    else:
                        print(f"❌ TCTI {tcti} falhou: {result.stderr.decode()}")
                        
                except Exception as e:
                    print(f"⚠️  Erro com TCTI {tcti}: {e}")
            
            # Se nenhum TCTI funcionar, tentar sem especificar (usar padrão)
            print("🔧 Tentando TPM sem TCTI específico...")
            result = subprocess.run(
                ['tpm2_getrandom', '4'], 
                capture_output=True, 
                timeout=10
            )
            
            if result.returncode == 0:
                print("✅ TPM responde sem TCTI específico")
                self.tcti = None
                return True, "TPM operacional (configuração padrão)"
            else:
                return False, f"TPM não responde em nenhuma configuração: {result.stderr.decode()}"
                
        except Exception as e:
            return False, f"Erro ao verificar TPM: {e}"
    
    def is_ready(self):
        return self.ready
    
    def _run_tpm_command(self, cmd):
        """Executa comando TPM com o TCTI configurado"""
        full_cmd = cmd.copy()
        if hasattr(self, 'tcti') and self.tcti:
            full_cmd.extend(['--tcti', self.tcti])
        return subprocess.run(full_cmd, capture_output=True, timeout=30)
    
    def encrypt(self, data):
        """Criptografa dados usando TPM real - abordagem simplificada"""
        try:
            if isinstance(data, str):
                data = data.encode()
            
            print("🔐 Criptografando com TPM real...")
            
            # Abordagem mais robusta: usar tpm2_create e tpm2_encryptdecrypt
            # 1. Criar contexto primário
            primary_ctx = "/tmp/primary.ctx"
            result = self._run_tpm_command([
                'tpm2_createprimary', '-c', primary_ctx, '-C', 'o', '-Q'
            ])
            
            if result.returncode != 0:
                print("❌ Falha ao criar contexto primário TPM")
                print(f"   Erro: {result.stderr.decode()}")
                return None
            
            # 2. Criar chave protegida pelo TPM
            key_public = "/tmp/key.pub"
            key_private = "/tmp/key.priv"
            key_ctx = "/tmp/key.ctx"
            
            result = self._run_tpm_command([
                'tpm2_create', '-C', primary_ctx, '-G', 'aes128',
                '-u', key_public, '-r', key_private, '-Q'
            ])
            
            if result.returncode != 0:
                print("❌ Falha ao criar chave AES no TPM")
                return None
            
            # 3. Carregar chave
            result = self._run_tpm_command([
                'tpm2_load', '-C', primary_ctx, '-u', key_public,
                '-r', key_private, '-c', key_ctx, '-Q'
            ])
            
            if result.returncode != 0:
                print("❌ Falha ao carregar chave no TPM")
                return None
            
            # 4. Criptografar dados
            input_file = "/tmp/tpm_input.bin"
            output_file = "/tmp/tpm_output.bin"
            
            with open(input_file, 'wb') as f:
                f.write(data)
            
            result = self._run_tpm_command([
                'tpm2_encryptdecrypt', '-c', key_ctx, '-o', output_file, input_file
            ])
            
            # Limpar arquivos temporários
            temp_files = [primary_ctx, key_public, key_private, key_ctx, input_file]
            for temp_file in temp_files:
                if os.path.exists(temp_file):
                    try:
                        os.unlink(temp_file)
                    except:
                        pass
            
            if result.returncode == 0 and os.path.exists(output_file):
                with open(output_file, 'rb') as f:
                    encrypted_data = f.read()
                os.unlink(output_file)
                
                print(f"✅ Dados criptografados com TPM: {len(encrypted_data)} bytes")
                return encrypted_data
            else:
                print(f"❌ Falha na criptografia TPM: {result.stderr.decode()}")
                return None
                
        except Exception as e:
            print(f"❌ Erro durante criptografia TPM: {e}")
            return None

def setup_tpm():
    """Configurar TPM para produção"""
    print("🔧 Inicializando TPM para produção...")
    return TPMHandler()

def wait_for_vault(vault_url, timeout=120):
    """Aguarda o Vault ficar pronto"""
    print(f"⏳ Aguardando Vault em {vault_url}...")
    start_time = time.time()
    
    while time.time() - start_time < timeout:
        try:
            response = requests.get(f"{vault_url}/v1/sys/health", timeout=5)
            if response.status_code in [200, 501, 503]:
                print("✅ Vault está respondendo")
                return True
        except requests.exceptions.RequestException:
            elapsed = int(time.time() - start_time)
            if elapsed % 10 == 0:
                print(f"⏳ Aguardando Vault... ({elapsed}s)")
            time.sleep(2)
    
    print("❌ Timeout aguardando Vault")
    return False

def initialize_vault(vault_url):
    """Inicializa o Vault em modo produção"""
    try:
        response = requests.get(f"{vault_url}/v1/sys/init", timeout=10)
        init_status = response.json()
        
        if not init_status.get('initialized', False):
            print("🚀 Inicializando Vault em modo produção...")
            init_data = {
                "secret_shares": 5,
                "secret_threshold": 3
            }
            response = requests.put(
                f"{vault_url}/v1/sys/init", 
                json=init_data, 
                timeout=30
            )
            
            if response.status_code == 200:
                init_result = response.json()
                print("✅ Vault inicializado em modo produção")
                print(f"📋 Chaves geradas: {len(init_result.get('keys_base64', []))}")
                return init_result
            else:
                print(f"❌ Erro na inicialização: {response.status_code}")
                return None
        else:
            print("✅ Vault já está inicializado")
            return None
            
    except Exception as e:
        print(f"❌ Erro ao verificar/inicializar Vault: {e}")
        return None

def save_encrypted_data(output_dir, init_result, tpm):
    """Salva dados criptografados com TPM"""
    if not init_result:
        print("❌ Nenhum dado para salvar")
        return False
    
    root_token = init_result.get('root_token')
    keys_base64 = init_result.get('keys_base64', [])
    
    success = True
    
    print(f"💾 Salvando {len(keys_base64)} chaves de unseal...")
    
    # Salvar root token criptografado
    if root_token:
        encrypted_token = tpm.encrypt(root_token)
        if encrypted_token:
            token_path = os.path.join(output_dir, "root_token.enc")
            with open(token_path, 'wb') as f:
                f.write(encrypted_token)
            print(f"✅ Token root criptografado salvo em: {token_path}")
        else:
            print("❌ Falha ao criptografar root token")
            success = False
    
    # Salvar chaves de unseal criptografadas
    for i, key in enumerate(keys_base64):
        encrypted_key = tpm.encrypt(key)
        if encrypted_key:
            key_path = os.path.join(output_dir, f"unseal_key_{i}.enc")
            with open(key_path, 'wb') as f:
                f.write(encrypted_key)
            print(f"✅ Chave {i} criptografada salva em: {key_path}")
        else:
            print(f"❌ Falha ao criptografar chave {i}")
            success = False
    
    return success

def main():
    print("=" * 60)
    print("🚀 INICIALIZADOR VAULT COM TPM - MODO PRODUÇÃO")
    print("=" * 60)
    
    vault_url = os.getenv('VAULT_ADDR', 'http://vault:8200')
    output_dir = "/app/tpm-data"
    
    print(f"📍 Vault URL: {vault_url}")
    print(f"📁 Output dir: {output_dir}")
    
    # Criar diretório de saída
    os.makedirs(output_dir, exist_ok=True)
    print(f"✅ Diretório {output_dir} preparado")
    
    # Inicializar TPM (obrigatório em produção)
    tpm = setup_tpm()
    
    # Aguardar Vault
    if not wait_for_vault(vault_url):
        sys.exit(1)
    
    # Inicializar Vault
    init_result = initialize_vault(vault_url)
    
    if init_result:
        # Salvar dados criptografados
        if save_encrypted_data(output_dir, init_result, tpm):
            print("\n✅ Dados de inicialização salvos com TPM")
            
            # Listar arquivos gerados
            print("\n📋 ARQUIVOS GERADOS:")
            for file in sorted(Path(output_dir).iterdir()):
                size = file.stat().st_size
                print(f"   📄 {file.name} ({size} bytes)")
            
            print("\n🎉 PROCESSO CONCLUÍDO COM SUCESSO!")
        else:
            print("❌ Falha ao salvar dados criptografados")
            sys.exit(1)
    else:
        print("⚠️  Vault já estava inicializado")
        print("💡 Execute o unseal manualmente com as chaves existentes")

if __name__ == '__main__':
    main()
