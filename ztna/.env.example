# ─────────────────────────────────────────────────────────────────────────────
# Twingate Connector — variáveis de ambiente (copie para .env)
#
# Gere os tokens no Admin Console do Twingate:
#   Network → Connectors → (novo Connector) → Deploy → On-premises → Docker
# O Console mostra ACCESS_TOKEN e REFRESH_TOKEN uma única vez. NÃO versione o .env.
# ─────────────────────────────────────────────────────────────────────────────

# Nome da rede Twingate (o "networkname" em https://networkname.twingate.com)
TWINGATE_NETWORK=seu-networkname

# Tokens do Connector (gerados no Admin Console). Mantenha em segredo.
TWINGATE_ACCESS_TOKEN=
TWINGATE_REFRESH_TOKEN=

# Rótulo (aparece no Admin Console). Padrão: ppgia96.
TWINGATE_LABEL_HOSTNAME=ppgia96
