# ── Cliente REST API (dispositivo IoT) — exemplo de configuração ──────────────
# Copie para .env e ajuste. NÃO versione o .env real.

# Identidade lógica do dispositivo (usada no path do Vault/TPM e no /login)
DEVICE_ID=device-001

# Endpoint do servidor REST
API_URL=http://127.0.0.1:5000
OTP_INTERVAL=60

# TLS (opcional) — CA do servidor para validar HTTPS. Se API_URL for https e
# CA_CERT não existir, a verificação padrão do sistema é usada.
# CA_CERT=/app/certs/ca.crt

# Credenciais estáticas OPCIONAIS (só se o servidor definir API_USER/API_PASS)
# API_USER=cliente-otp
# API_PASS=troque-esta-senha

# ── TPM (fonte primária do segredo TOTP) ──────────────────────────────────────
# O segredo é recuperado de <TPM_DATA_DIR>/<DEVICE_ID>_otp.enc.pub/.priv
TPM_DATA_DIR=/app/tpm-data
TPM_SRK_HANDLE=0x81010001
TPM2TOOLS_TCTI=device:/dev/tpmrm0

# ── Fallback de desenvolvimento (usado se o TPM estiver indisponível) ─────────
# OTP_SECRET=BASE32SECRETEXAMPLE234567
