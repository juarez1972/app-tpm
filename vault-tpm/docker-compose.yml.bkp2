services:
  vault:
    image: vault:1.13.3
    container_name: vault
    ports:
      - "8201:8200"
    environment:
      - VAULT_ADDR=http://vault:8200
      - VAULT_API_ADDR=http://vault:8200
    volumes:
      - ./vault-data:/vault/data
      - ./vault-config.hcl:/vault/config/vault-config.hcl
    command: server -config=/vault/config/vault-config.hcl
    cap_add:
      - IPC_LOCK
    networks:
      - vault-network

  vault-initializer:
    build: 
      context: ./vault-init
      dockerfile: Dockerfile.alpine
    container_name: vault-initializer
    volumes:
      - ./tpm-data:/app/tpm-data
      - ./vault-data:/vault-data
    devices:
      - "/dev/tpm0:/dev/tpmrm0"
    environment:
      - VAULT_ADDR=http://vault:8200
    depends_on:
      - vault
    networks:
      - vault-network

  tpm-validator:
    build: 
      context: ./tpm-validator
      dockerfile: Dockerfile.alpine
    container_name: tpm-validator
    volumes:
      - ./tpm-data:/app/tpm-data
    devices:
      - "/dev/tpm0:/dev/tpm0"
    depends_on:
      - vault-initializer
    networks:
      - vault-network

networks:
  vault-network:
    driver: bridge

volumes:
  vault-data:
    driver: local
  tpm-data:
    driver: local
