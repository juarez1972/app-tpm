# ── Cliente MQTT (dispositivo IoT) — exemplo de configuração ──────────────────
# Copie para .env e ajuste. NÃO versione o .env real.

# Identidade lógica do dispositivo (usada no tópico e no path do Vault/TPM)
DEVICE_ID=device-001

# Broker MQTT do servidor (via extra_hosts no compose, ou IP direto)
MQTT_BROKER=mqttserver.local
MQTT_PORT=8883
MQTT_TOPIC_VERIFY=iot/verify
OTP_INTERVAL=60
# On-the-wire OTP transport: 'hmac' (HMAC envelope, default) or 'plain' (legacy).
# In 'hmac' the raw TOTP code never travels in cleartext.
OTP_MODE=hmac

# TLS (opcional) — apenas a CA do servidor; sem chave privada no cliente
CA_CERT=/app/certs/ca.crt

# ── TPM (fonte primária do segredo TOTP) ──────────────────────────────────────
# O segredo é recuperado de <TPM_DATA_DIR>/<DEVICE_ID>_otp.enc.pub/.priv
TPM_DATA_DIR=/app/tpm-data
TPM_SRK_HANDLE=0x81010001
TPM2TOOLS_TCTI=device:/dev/tpmrm0

# ── Fallback de desenvolvimento (usado se o TPM estiver indisponível) ─────────
# OTP_SECRET=BASE32SECRETEXAMPLE234567
