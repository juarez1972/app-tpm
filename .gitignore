# Python virtualenvs (nunca versionar)
venv/
.venv/
env/
ENV/

# Bytecode / caches Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Dados sensíveis / runtime do vault-tpm (blobs do TPM, storage do Vault)
tpm-data/
vault-data/
vault-file/

# Arquivos de ambiente com segredos (mantém os .env.example versionados)
.env
*/.env
**/.env
!.env.example
!**/.env.example

# Certificados de runtime (gerados por gerar_certificados.py)
certs/

# Logs
*.log

# Sistema operacional / editores
.DS_Store
*.swp
