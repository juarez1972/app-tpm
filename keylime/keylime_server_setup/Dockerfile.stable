FROM fedora:37  # Usar Fedora 37 para melhor compatibilidade

# Instalar dependências do sistema
RUN dnf update -y && \
    dnf install -y python3-pip python3-devel git gcc openssl-devel openssl python3-gpg sqlite tpm2-tools && \
    dnf clean all

# Criar diretórios necessários
RUN mkdir -p /var/lib/keylime /etc/keylime

# Instalar Keylime versão 6.5.0 (mais estável)
RUN pip3 install keylime==6.5.0

WORKDIR /app

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python3 -c "import keylime; print('OK')" || exit 1
