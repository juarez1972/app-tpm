# ── Servidor REST API (FastAPI) — exemplo de configuração ─────────────────────
# Copie para .env e ajuste. NÃO versione o .env real.

# Bind da API
API_HOST=0.0.0.0
API_PORT=5000
OTP_INTERVAL=60
# On-the-wire OTP transport: 'hmac' (HMAC envelope, default) or 'plain' (legacy).
# In 'hmac' the raw TOTP code never travels in cleartext.
OTP_MODE=hmac

# Credenciais estáticas OPCIONAIS do /login (além do device_id).
# Deixe em branco para exigir apenas um device_id provisionado.
# API_USER=cliente-otp
# API_PASS=troque-esta-senha

# ── HashiCorp Vault (fonte primária dos segredos por dispositivo) ─────────────
# O servidor lê o segredo TOTP de secret/data/<VAULT_DEVICE_BASE>/<device_id>
VAULT_ADDR=http://192.168.56.106:8200
# Token com a policy 'app-policy' (ex.: app_token recuperado do TPM no vault-tpm)
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_DEVICE_BASE=tpm-verified/iot/devices
VAULT_SECRET_FIELD=otp_secret

# ── Fallback de desenvolvimento (usado se o Vault estiver indisponível) ───────
# Segredo TOTP único para todos os dispositivos — APENAS para testes locais.
# OTP_SECRET=BASE32SECRETEXAMPLE234567
